<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- WinExe : pour le joueur, l'installeur est une fenetre. Les deux modes caches
             (generer-edition, extraire-donnees ; voir Program.cs) se rattachent a la console de
             l'appelant. -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Pas de WinForms : il ne s'elague pas et pesait une quarantaine de Mo dans l'installeur
             publie. La fenetre est en Win32 natif (Interface/), le COM en interfaces generees, le
             JSON en serialiseur genere : tout est compatible avec l'elagage, et avec une
             compilation native plus tard. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsTrimmable>true</IsTrimmable>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <PlatformTarget>x86</PlatformTarget>
        <AssemblyName>OpenForesia-Setup</AssemblyName>
        <RootNamespace>OpenForesia.Installer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- La liste des fichiers attendus, generee par le mode generer-edition depuis l'ISO de
             reference. Aucune donnee du jeu : des noms, des tailles et des sommes. Le jeu embarque
             le meme fichier par un lien (voir OpenForesia.csproj). -->
        <EmbeddedResource Include="Editions\editions.json">
            <LogicalName>editions.json</LogicalName>
        </EmbeddedResource>

        <!-- Les reglages d'affichage par defaut, commentes, deposes a l'installation s'il n'y en a
             pas deja (Installation.DeposerReglagesAffichage). -->
        <EmbeddedResource Include="Reglages\Affichage.ini">
            <LogicalName>Affichage.ini</LogicalName>
        </EmbeddedResource>

        <!-- Le jeu publie, zippe par publish-release.ps1. Absent en developpement : l'installeur
             prend alors les fichiers du jeu dans un dossier donne par l'option jeu. -->
        <EmbeddedResource Include="Jeu\jeu.zip" Condition="Exists('Jeu\jeu.zip')">
            <LogicalName>jeu.zip</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
