<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- WinExe : pour le joueur, le multijoueur est une fenetre. Les modes du developpeur
             (voir Program.cs) se rattachent a la console de l'appelant. -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Les memes regles que l'installeur (openspec/changes/add-multiplayer-streaming, D1) : pas
             de WinForms, fenetres Win32 natives, COM en interfaces generees, JSON par serialiseur
             genere — tout compatible avec l'elagage d'une publication en un seul fichier. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsTrimmable>true</IsTrimmable>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <PlatformTarget>x86</PlatformTarget>
        <AssemblyName>OpenForesiaMultiplayer</AssemblyName>
        <RootNamespace>OpenForesia.Multiplayer</RootNamespace>
    </PropertyGroup>

</Project>
