<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- `-windows` et UseWindowsForms : le verbe `montee` ouvre une fenetre (le simulateur de
             montee de niveau, MonteeDeNiveau/). OutputType reste Exe et non WinExe pour que les
             cinq autres verbes gardent leur console. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PlatformTarget>x86</PlatformTarget>
        <Prefer32Bit>true</Prefer32Bit>

        <!-- Le simulateur travaille sur un vrai bloc de personnage de 0x2000 octets, aux memes
             decalages que le jeu, pour que la transcription de FUN_005391f0 reste lisible a cote
             de l'originale. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Iced" Version="1.21.0" />
    </ItemGroup>

    <!-- Le verbe `indeo` compare le decodeur Indeo 4 du jeu au codec d'Intel : il compile les memes
         sources que le jeu plutot que d'en garder une copie, pour que ce soit bien CE decodeur qui
         soit verifie. -->
    <ItemGroup>
      <Compile Include="..\OpenForesia\src\Host\AviReader.cs" Link="Indeo\Jeu\AviReader.cs" />
      <Compile Include="..\OpenForesia\src\Host\Yvu9Rgb.cs" Link="Indeo\Jeu\Yvu9Rgb.cs" />
      <Compile Include="..\OpenForesia\src\Host\Indeo4\**\*.cs" Link="Indeo\Jeu\Indeo4\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
