<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PlatformTarget>x86</PlatformTarget>
        <Prefer32Bit>true</Prefer32Bit>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Aucun binaire de 1998 n'est plus livre. Les cinq DLL d'aide ne le sont plus depuis le
             2026-09-23 : leur code est en C# (src/Libraries/), et les donnees qu'on y lisait encore
             sont transcrites en C# (fichiers generes) ou, pour les deux polices, embarquees
             ci-dessous depuis src/Libraries/Donnees/. Le codec des films, ir41_32.ax, ne l'est plus
             depuis le 2026-09-24 : son remplacant est src/Host/Indeo4/. -->

        <EmbeddedResource Include="src\Libraries\Donnees\*.bin">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- La liste des fichiers attendus, que Host/GameDataCheck.cs verifie au demarrage. Le
             fichier appartient a l'installeur, qui le genere depuis l'ISO de reference : un lien,
             pour qu'il n'en existe qu'un exemplaire. -->
        <EmbeddedResource Include="..\OpenForesia.Installer\Editions\editions.json" Link="Host\editions.json">
            <LogicalName>editions.json</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\Blaze\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
      <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    </ItemGroup>

</Project>